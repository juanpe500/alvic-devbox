#!/usr/bin/env python3
"""Fake `claude` for testing the devbox agent: honors --session-id/--resume and --settings
hooks, writes a transcript like the real one, and echoes each typed line as a turn."""
import json, os, subprocess, sys, time

args = sys.argv[1:]
def flag(name):
    return args[args.index(name) + 1] if name in args else None

sid = flag("--session-id") or flag("--resume")
settings = json.load(open(flag("--settings"))) if flag("--settings") else {"hooks": {}}
cwd = os.getcwd()
proj = os.path.join(os.path.expanduser("~"), ".claude", "projects", "".join(c if c.isalnum() else "-" for c in cwd))
os.makedirs(proj, exist_ok=True)
path = os.path.join(proj, sid + ".jsonl")

def hook(event_key):
    for group in settings["hooks"].get(event_key, []):
        for h in group["hooks"]:
            subprocess.run(h["command"], shell=True, input=json.dumps({"permission_mode": "acceptEdits"}), text=True)

def log(obj):
    obj.setdefault("cwd", cwd)
    with open(path, "a") as fh:
        fh.write(json.dumps(obj) + "\n")

hook("SessionStart")
print(f"fake claude {sid} {'resumed' if '--resume' in args else 'new'}", flush=True)
for line in sys.stdin:
    text = line.strip()
    if not text:
        continue
    if text == "/remote-control":
        print("remote control on", flush=True)
        log({"type": "system", "message": None, "rc": True})
        continue
    hook("UserPromptSubmit")
    log({"type": "user", "message": {"content": text}, "timestamp": "2026-11-25T10:00:00Z"})
    time.sleep(0.3)
    log({"type": "assistant", "message": {"content": [{"type": "text", "text": "echo: " + text},
        {"type": "tool_use", "name": "Bash", "input": {"command": "ls -la"}}]}, "timestamp": "2026-11-25T10:00:01Z"})
    hook("Stop")
    print("echo:", text, flush=True)
